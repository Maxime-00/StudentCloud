# Gebruik:
#   cp .env.example .env
#   # vul de waarden in en genereer sterke wachtwoorden

# --- Testpoort (tijdelijk, tot reverse proxy van persoon 1 actief is) ---
# NOG INVULEN: kies een poort die vrij is op de VM.
HTTP_PORT=8080

# --- Database ---
DB_NAME=nextcloud
DB_USER=studentencloud
# Sterk wachtwoord nog genereren
DB_PASSWORD=WISSEL_MIJ
DB_ROOT_PASSWORD=WISSEL_MIJ_OOK

# --- Reverse proxy / TLS (in te vullen door persoon 1) ---
# Comma-gescheiden lijst met IP's/subnets van de reverse proxy.
TRUSTED_PROXIES=
# Zet op "https" zodra TLS via de reverse proxy actief is.
OVERWRITEPROTOCOL=http
# NOG INVULEN door persoon 1: echte domein/hostname, bijv. cloud.scholen.example
# OVERWRITEHOST=
# OVERWRITESECCONFIG=true
